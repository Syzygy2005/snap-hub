# Leave DATABASE_URL empty for local development: an embedded Postgres (PGlite) is stored in .data/pglite.
# In production, use your Supabase "Transaction pooler" connection string (port 6543).
DATABASE_URL=

# Protects /api/cron/snapshot. Required in production. Any long random string.
CRON_SECRET=

# Optional. When set, people need this code to create a stats tracker key (stops strangers adding games).
TRACKER_INVITE_CODE=

# Comma-separated. Only "global" returns data as of Sept 2026; add others if Marvel Snap fixes regional boards.
LEADERBOARD_REGIONS=global
